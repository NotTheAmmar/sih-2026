# ──────────────────────────────────────────────────────────────────
# KalaKriti BPP — Environment Configuration
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────

# ── ONDC Identity ────────────────────────────────────────────────
# BPP Subscriber ID registered on the ONDC network.
# For Workbench mock testing this can be any identifier.
BPP_SUBSCRIBER_ID=kalakriti.bpp.org

# Unique Key ID — identifies this specific signing key.
# Must match the key registered in the ONDC registry.
BPP_UK_ID=key-1

# Ed25519 keypair (base64 encoded).
# Generate with: python generate_keys.py
BPP_SIGNING_PRIVATE_KEY=
BPP_SIGNING_PUBLIC_KEY=

# ── Network ──────────────────────────────────────────────────────
# The publicly reachable URI of THIS BPP server (what the network
# will use to address on_* callbacks back to us).
# When tunneling with Cloudflare: cloudflared tunnel --url http://localhost:8000
# then set this to your tunnel URL + /beckn
BPP_PUBLIC_URI=http://localhost:8000/beckn

# ONDC Gateway URL — leave empty for Workbench / mock testing.
# For staging: https://pilot-gateway-01.beckn.delhivery.com/search
GATEWAY_URL=

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Pipeline control ────────────────────────────────────────────────────────
# Set to false to enable live AI processing (Groq + Gemini)
USE_MOCK_DATA=true

# Voice pipeline: "groq" | "bhashini" | "ai4bharat" | "auto"
# "auto" = uses Groq if GROQ_API_KEY is set, else tries backend
VOICE_PIPELINE=auto

# ── Path 3: Groq + Gemini (recommended for jury demo) ───────────────────────
# Get from: https://console.groq.com  (free, no credit card)
GROQ_API_KEY=your_groq_key_here

# Get from: https://aistudio.google.com  (free tier, 1500 req/day)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Path 2: Bhashini Cloud (govt endpoints, apply via SPOC) ─────────────────
BHASHINI_API_KEY=your_bhashini_key_here
BHASHINI_ULCA_KEY=your_ulca_key_here
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in

# ── Path 1: AI4Bharat self-hosted backend (FastAPI on GPU VM) ────────────────
BACKEND_URL=http://localhost:8000
n# ── BPP Backend (ONDC Beckn Provider Platform, separate from AI backend) ────
BPP_BACKEND_URL=http://localhost:8000

# ── Misc ─────────────────────────────────────────────────────────────────────
API_BASE_URL=https://api.kalakriti.dev/v1
